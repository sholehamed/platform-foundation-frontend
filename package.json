{
  "name": "platform-foundation-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/material": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@playwright/test": "^1.56.0",
    "angular-eslint": "22.5.0",
    "eslint": "^9.39.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.8"
  }
}
